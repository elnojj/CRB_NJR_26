  "single_motion_authority": {
    "masterClockOwner": "CosmographCanvas.AnimationLoop (requestAnimationFrame delta clock)",
    "cameraOrchestratorOwner": "CosmographCanvas.CameraRig + spatialNavigation.executeAtomicReframe",
    "tourSequenceOwner": "cerebroTourAndCtaStore (CEREBRO_18_TOUR_CHOREOGRAPHY)",
    "domUiChoreographyOwner": "motionTokens.ts + CSS cubic-bezier(0.22, 1, 0.36, 1)",
    "conflictPreventionRule": "No two animation systems may write to the same mesh transform or camera pose simultaneously; user pointer/touch immediately pauses tour auto-stepping and transfers camera ownership cleanly."
  },
  "rules": {
    "master_clock": "absolute seconds; frame/fps; one camera authority",
    "camera": "C2-continuous position spline, quaternion orientation, smooth FOV; world-anchored portals; no DOM resize teleport",
    "text": "glyph stagger 2 frames; 12-frame opacity/lift entry; 66-frame min readable hold; 10-frame exit; clamp glyph progress to [0,1]",
    "glyph_formula": "p=clamp((frame-inFrame-glyphIndex*2)/12,0,1); opacity=p*p*(3-2*p); offsetY=(1-opacity)*8 CSS px; retain final layout metrics",
    "panel": "420ms translateY 12px -> 0 and opacity 0 -> 1; focus remains inside visible panel",
    "idle": "2 degrees/second yaw, .008R sin(2*pi*t/6) vertical drift",
    "voice": "audio level smoothed attack 80ms, release 240ms; rings scale 1+0.04*level; do not randomize speaking state",
    "media": "sourceTime=inPoint+(t-componentIn); deterministic decode for exports; no hard crop changes",
    "reduced_motion": "hold camera and replace travel with short opacity handoffs; keep all controls operable"
  },
