{
  "$schema": "https://nojara.studios/schemas/cerebro-39-camera-registry-v2.json",
  "version": "2.0.0-cerebro39-master",
  "singleCameraAuthority": {
    "controllerId": "CAM_RIG_PRIMARY_CEREBRO",
    "ownerFile": "src/components/CosmographCanvas.tsx",
    "presetsFile": "src/gui/cameraPresets.ts",
    "splineHelperFile": "src/three/spatialNavigation.tsx",
    "sensorFormatMm": [36, 24],
    "opticalFormula": "vFovDeg = 2 * atan(24 / (2 * focalLengthMm)) * (180 / PI)",
    "arbitrationRule": "Exactly one camera command executes at a time; user pointer/wheel input immediately cancels active spline flight and transitions camera mode to interactive_exploration without sudden position jumps."
  },
  "cinema_lenses": [
    { "id": "28mm", "focalLengthMm": 28, "verticalFovDeg": 46.4, "useCase": "Wide spatial environment & dual-sphere overview" },
    { "id": "35mm", "focalLengthMm": 35, "verticalFovDeg": 37.8, "useCase": "Default master phone & desktop hero framing" },
    { "id": "50mm", "focalLengthMm": 50, "verticalFovDeg": 27.0, "useCase": "Focused station / node inspection" },
    { "id": "85mm", "focalLengthMm": 85, "verticalFovDeg": 16.1, "useCase": "Editorial portrait close-up & media portal aperture" }
  ],
  "user_control_handoff_modes": [
    { "mode": "cinematic_playback", "description": "Authored tour or film-state spline controls camera pose and FOV." },
    { "mode": "interactive_exploration", "description": "User 1-finger orbit / 2-finger pinch / wheel dolly controls camera rig with damping." },
    { "mode": "transitioning_to_interaction", "description": "Immediate velocity-preserving handoff when user touches canvas during playback." },
    { "mode": "returning_to_presentation", "description": "Smooth quintic S-curve re-entry from current user pose to next sequence keyframe." },
    { "mode": "paused", "description": "Holds current world position, target, and FOV without drift." },
    { "mode": "error_recovery", "description": "Atomic reframe to unobstructed home composition via executeAtomicReframe." }
  ],
  "camera_shots": [
