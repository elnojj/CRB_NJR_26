      "cameraTarget": [0, 0, 0],
      "fovDeg": 37.8,
      "lensId": "35mm",
      "trajectory": "CatmullRomCurve3 + Quaternion.slerp",
      "easing": "cubic-bezier(0.22, 1, 0.36, 1)",
      "subjectComponentId": "C05_SPHERE_STAGE",
      "focusBehavior": "center_stage_idle_50W_52H",
