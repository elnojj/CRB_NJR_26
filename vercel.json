{
  "buildCommand": "VITE_BASE=/cro/ npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/",
      "destination": "/cro/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/cro",
      "destination": "/index.html"
    },
    {
      "source": "/cro/",
      "destination": "/index.html"
    },
    {
      "source": "/cro/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/cro/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/cro/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
