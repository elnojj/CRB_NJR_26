# Local / AI Studio env template for CEREBRO + CDE (Subz)
PORT=3847

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# Optional Google Drive API key for /api/drive/stream/:fileId (Hotspot_26_media).
# Without it, localFallback media under public/media/ is used when present.
GOOGLE_API_KEY=
GOOGLE_DRIVE_API_KEY=

# ELEVENLABS_API_KEY & ELEVENLABS_AGENT_ID: Optional for live Cro-cde-google voice agent.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
