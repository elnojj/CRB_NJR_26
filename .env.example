# Local / AI Studio env template for CEREBRO + CDE (Subz)
PORT=3847

# GEMINI_API_KEY: Required for Google AI Studio / Gemini voice turns + screen orchestration.
# AI Studio automatically injects this at runtime from user secrets.
# Primary Cerebro voice path: Google Voice (SpeechRecognition) → /api/gemini/voice-turn → speechSynthesis.
GEMINI_API_KEY=

# Optional Google Drive API key for /api/drive/stream/:fileId (Hotspot_26_media).
# Without it, localFallback media under public/media/ is used when present.
GOOGLE_API_KEY=
GOOGLE_DRIVE_API_KEY=

# ELEVENLABS_* are legacy only — disconnected from the primary VoiceCard path.
# Kept for optional offline export / historical agent id reference.
# ELEVENLABS_API_KEY=
# ELEVENLABS_AGENT_ID=
