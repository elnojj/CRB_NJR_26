# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Voice provider defaults to OpenAI Realtime. Keep API keys server-side only.
VITE_CEREBRO_VOICE_PROVIDER="openai-realtime"
# Optional custom badge text; blank derives OpenAI Voice / Google Voice from provider.
VITE_CEREBRO_VOICE_LABEL=""
OPENAI_API_KEY=""
OPENAI_REALTIME_MODEL="gpt-realtime"
OPENAI_REALTIME_VOICE="marin"
# Optional server-side Firebase UID allowlist for voice access (comma-separated).
CEREBRO_VOICE_ALLOWED_UIDS=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_BASE: Asset/public path. Use /cro/ for labs.nojara.com production deploys.
# VITE_BASE=/cro/

# VERCEL_TOKEN: Required to deploy/alias to labs.nojara.com (Vercel project owning that domain).
# VERCEL_TOKEN=""

# ELEVENLABS_API_KEY & ELEVENLABS_AGENT_ID: Optional for live Cro-cde-google voice agent provisioning.
ELEVENLABS_API_KEY=""
ELEVENLABS_AGENT_ID=""

# Firebase web config for Google Workspace sign-in (client, injected at build time) and voice identity checks (server).
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
# Optional server-only override; falls back to VITE_FIREBASE_API_KEY.
FIREBASE_API_KEY=""
